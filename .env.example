# Site-specific build/deploy settings for scripts/build.sh.
#
# Copy to .env and fill in. .env is gitignored: registry hostnames, image
# names and deploy paths describe someone's infrastructure, not this project,
# and have no business in a public repository.

# Registry to push to, e.g. registry.example.com or ghcr.io/<user>.
# Leave empty to build locally without pushing.
REGISTRY=

# Image name within the registry.
IMAGE_NAME=onetagger

# Moving tag your deployment references (what `docker compose up -d` resolves).
# The build always pushes an immutable :<short-sha> tag beside it -- that is the
# rollback point and the only thing tying a container back to a commit.
MOVING_TAG=latest

# Local tag used during the build, before tagging for the registry.
LOCAL_TAG=onetagger-local:latest

# Space-separated compose project directories to `docker compose up -d` after a
# successful push. Leave empty to skip deployment.
# NOTE: list every stack sharing this image, or one is left on the old build.
# Quote it -- the value contains spaces and this file is sourced, not parsed.
DEPLOY_DIRS=""
